{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "Extended user profile information including gamification stats.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "photoURL": { "type": "string" },
        "points": { "type": "integer" },
        "streak": { "type": "integer" },
        "lastActive": { "type": "string", "format": "date-time" },
        "badges": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "points", "streak", "createdAt"]
    },
    "Note": {
      "title": "Uploaded Note",
      "description": "Metadata and AI analysis for a student's uploaded note.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "subject": { "type": "string" },
        "topic": { "type": "string" },
        "fileType": { "type": "string" },
        "fileUrl": { "type": "string" },
        "contentSummary": { "type": "string" },
        "extractedConcepts": { 
          "type": "array", 
          "items": { 
            "type": "object",
            "properties": {
              "term": { "type": "string" },
              "definition": { "type": "string" }
            }
          }
        },
        "keyPoints": { "type": "array", "items": { "type": "string" } },
        "labels": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "title", "fileUrl", "createdAt"]
    },
    "Quiz": {
      "title": "Generated Quiz",
      "description": "A quiz generated by AI based on a note or subject.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "noteId": { "type": "string" },
        "subject": { "type": "string" },
        "questions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "question": { "type": "string" },
              "type": { "type": "string", "enum": ["mcq", "true_false", "fill_blank", "short_answer"] },
              "options": { "type": "array", "items": { "type": "string" } },
              "correctAnswer": { "type": "string" },
              "explanation": { "type": "string" },
              "difficulty": { "type": "string", "enum": ["easy", "medium", "hard"] }
            }
          }
        },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "questions", "createdAt"]
    },
    "QuizResult": {
      "title": "Quiz Result",
      "description": "The outcome of a student's quiz attempt.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "quizId": { "type": "string" },
        "score": { "type": "integer" },
        "totalQuestions": { "type": "integer" },
        "performanceAnalysis": { "type": "string" },
        "weakAreas": { "type": "array", "items": { "type": "string" } },
        "recommendations": { "type": "array", "items": { "type": "string" } },
        "completedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "quizId", "score", "totalQuestions", "completedAt"]
    },
    "StudySession": {
       "title": "Study Session",
       "description": "Record of a revision session.",
       "type": "object",
       "properties": {
         "userId": { "type": "string" },
         "subject": { "type": "string" },
         "topic": { "type": "string" },
         "durationMinutes": { "type": "integer" },
         "createdAt": { "type": "string", "format": "date-time" }
       },
       "required": ["userId", "durationMinutes", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile documents."
    },
    "/notes": {
      "schema": "Note",
      "description": "All uploaded notes metadata."
    },
    "/quizzes": {
      "schema": "Quiz",
      "description": "Historical quizzes generated for users."
    },
    "/quizResults": {
      "schema": "QuizResult",
      "description": "Results of taken quizzes."
    },
    "/studySessions": {
      "schema": "StudySession",
      "description": "Records of time spent studying."
    }
  }
}
