rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. PRIMITIVES & HELPERS
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isVerified() { return request.auth.token.email_verified == true; }

    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. USER PROFILES
    match /users/{userId} {
      function isValidUser(data) {
        return data.keys().hasAll(['uid', 'email', 'points', 'streak', 'createdAt']) &&
               data.keys().size() <= 9 &&
               data.uid == request.auth.uid &&
               data.email is string &&
               data.points is int &&
               data.streak is int &&
               data.createdAt is timestamp;
      }

      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(incoming()) && incoming().createdAt == request.time;
      allow update: if isOwner(userId) && isValidUser(incoming()) && (
        // Allow updating streak and points
        incoming().diff(existing()).affectedKeys().hasOnly(['points', 'streak', 'lastActive', 'badges'])
      );
    }

    // 3. NOTES
    match /notes/{noteId} {
      function isValidNote(data) {
        return data.keys().hasAll(['userId', 'title', 'fileUrl', 'createdAt']) &&
               data.userId == request.auth.uid &&
               data.title is string && data.title.size() <= 200 &&
               data.fileUrl is string && data.fileUrl.size() <= 1000 &&
               data.createdAt is timestamp;
      }

      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidNote(incoming()) && incoming().createdAt == request.time;
      allow update: if isSignedIn() && isOwner(existing().userId) && isValidNote(incoming()) && (
        incoming().diff(existing()).affectedKeys().hasOnly(['title', 'subject', 'topic', 'contentSummary', 'extractedConcepts', 'keyPoints', 'labels'])
      );
      allow delete: if isSignedIn() && isOwner(existing().userId);
    }

    // 4. QUIZZES
    match /quizzes/{quizId} {
      function isValidQuiz(data) {
        return data.keys().hasAll(['userId', 'questions', 'createdAt']) &&
               data.userId == request.auth.uid &&
               data.questions is list &&
               data.createdAt is timestamp;
      }

      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidQuiz(incoming()) && incoming().createdAt == request.time;
    }

    // 5. QUIZ RESULTS
    match /quizResults/{resultId} {
      function isValidResult(data) {
        return data.keys().hasAll(['userId', 'quizId', 'score', 'totalQuestions', 'completedAt']) &&
               data.userId == request.auth.uid &&
               data.score is int &&
               data.completedAt is timestamp;
      }

      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidResult(incoming()) && incoming().completedAt == request.time;
    }

    // 6. STUDY SESSIONS
    match /studySessions/{sessionId} {
      function isValidSession(data) {
        return data.userId == request.auth.uid &&
               data.durationMinutes is int &&
               data.createdAt is timestamp;
      }
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidSession(incoming()) && incoming().createdAt == request.time;
    }
  }
}
